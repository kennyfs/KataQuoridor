{
 "vars": {
  "katago": "{repo}/cpp/build-cuda/katago",
  "arbiter_katago": "{repo}/cpp/build/katago",
  "models_dir": "{env:KATAQUORIDOR_MODELS_DIR}",
  "gtp_config": "{repo}/cpp/configs/gtp_quoridor.cfg",
  "katago_overrides": "numSearchThreads=1,allowResignation=false,ponderingEnabled=false,logAllGTPCommunication=false,logSearchInfo=false,logDir={out}/gtp_logs,nnCacheSizePowerOfTwo=17",
  "simple_quoridor": "{env:SIMPLE_QUORIDOR}"
 },
